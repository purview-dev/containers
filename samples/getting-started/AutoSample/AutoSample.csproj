<Project Sdk="Microsoft.NET.Sdk">
	<!--
	  The zero-configuration shape: a platform-neutral net10.0 project that references BOTH backends and two
	  service modules, and lets automatic selection choose. It needs no target framework for Windows, no
	  backend in code and no environment variable - on a Windows developer machine it runs on WSL
	  Containers, and on a Linux/macOS machine on Docker.

	  This sample references the projects (so it builds from a clone); a real consumer adds the packages
	  instead and gets the registration generated by their buildTransitive assets.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../../../src/src/Redis/Redis.csproj" />
		<ProjectReference Include="../../../src/src/PostgreSql/PostgreSql.csproj" />
		<ProjectReference Include="../../../src/src/Containers/Containers.csproj" />
	</ItemGroup>

	<!--
	  A package consumer gets the WSLC implementation payload from Purview.Containers.Wsl's buildTransitive
	  targets automatically. This sample references the projects instead (so it builds from a clone), and the
	  umbrella project reference does not carry buildTransitive assets, so it assembles the same "wslc/"
	  payload by hand: on a Windows build host, the facade loads the implementation from there and the sample
	  can run on WSLC. On other hosts there is no payload and auto-selection uses Docker, which is the point
	  of the sample.
	-->
	<PropertyGroup>
		<WslWindowsOutput>$(MSBuildThisFileDirectory)../../../src/src/Wsl/bin/$(Configuration)/net10.0-windows10.0.19041.0/</WslWindowsOutput>
		<!--
		  Both versions come from Directory.Packages.props, which is the only place they are declared
		  (see the note there). Addressing the payload by a hardcoded version is what let the path
		  drift from the central pin and break the CI pack.
		-->
		<WslcPayloadSource>$(NuGetPackageRoot)microsoft.wsl.containers/$(MicrosoftWSLContainersVersion)</WslcPayloadSource>
		<WindowsSdkPayloadSource>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref/$(WindowsSdkRefPackageVersion)</WindowsSdkPayloadSource>
	</PropertyGroup>

	<Target Name="CopyWslcPayload" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
		<ItemGroup>
			<WslcPayload Include="$(WslWindowsOutput)Purview.Containers.Wsl.dll" />
			<WslcPayload Include="$(WslcPayloadSource)/lib/net8.0-windows10.0.19041.0/wslcsdkcs.dll" />
			<WslcPayload Include="$(WslcPayloadSource)/runtimes/win-x64/native/wslcsdk.dll" />
			<WslcPayload Include="$(WindowsSdkPayloadSource)/lib/net8.0/Microsoft.Windows.SDK.NET.dll" />
			<WslcPayload Include="$(WindowsSdkPayloadSource)/lib/net8.0/WinRT.Runtime.dll" />
		</ItemGroup>
		<!--
		  Fail fast, for the same reason as the Wsl package's payload target: a Copy over a missing
		  source is a confusing error, and a bumped pin that is not restored is the likely cause.
		-->
		<Error
			Condition="!Exists('$(WslWindowsOutput)Purview.Containers.Wsl.dll')"
			Text="The Windows implementation is not built. Run 'just build' (or build src/src/Wsl/Wsl.csproj) first."
		/>
		<Error
			Condition="!Exists('$(WslcPayloadSource)/lib/net8.0-windows10.0.19041.0/wslcsdkcs.dll')"
			Text="The WSLC projection is missing at '$(WslcPayloadSource)/lib/net8.0-windows10.0.19041.0/wslcsdkcs.dll'. MicrosoftWSLContainersVersion ('$(MicrosoftWSLContainersVersion)') in Directory.Packages.props must match the Microsoft.WSL.Containers version this project restores."
		/>
		<Error
			Condition="!Exists('$(WslcPayloadSource)/runtimes/win-x64/native/wslcsdk.dll')"
			Text="The native WSLC SDK is missing at '$(WslcPayloadSource)/runtimes/win-x64/native/wslcsdk.dll'. MicrosoftWSLContainersVersion ('$(MicrosoftWSLContainersVersion)') in Directory.Packages.props must match the Microsoft.WSL.Containers version this project restores."
		/>
		<Error
			Condition="!Exists('$(WindowsSdkPayloadSource)/lib/net8.0/Microsoft.Windows.SDK.NET.dll')"
			Text="The Windows SDK projection is missing at '$(WindowsSdkPayloadSource)/lib/net8.0/Microsoft.Windows.SDK.NET.dll'. WindowsSdkRefPackageVersion ('$(WindowsSdkRefPackageVersion)') in Directory.Packages.props must match WindowsSdkPackageVersion."
		/>
		<Copy SourceFiles="@(WslcPayload)" DestinationFolder="$(OutDir)wslc" SkipUnchangedFiles="true" />
		<Message Importance="high" Text="WSL Containers payload copied to $(OutDir)wslc" />
	</Target>
</Project>
