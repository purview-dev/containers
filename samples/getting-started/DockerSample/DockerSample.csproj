<Project Sdk="Microsoft.NET.Sdk">
	<!--
	  A consumer-shaped sample for the Docker backend: portable, no Windows target framework required.
	  Prerequisite: a reachable Docker daemon (`docker info`).
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- In a real project: dotnet add package Purview.Containers.Docker -->
		<ProjectReference Include="../../../src/src/Docker/Docker.csproj" />
	</ItemGroup>
</Project>
