<Project>
	<PropertyGroup>
		<!--
		  Must be set here, not left to the SDK default: NuGet imports Directory.Packages.props before
		  the SDK props that would set these, so without this block every PackageReference fails with
		  NU1015 ("no version specified").
		-->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<!--
	  Single source of truth for the two packages the WSL Containers backend does not merely reference
	  but copies out of the NuGet cache by path.

	    Microsoft.WSL.Containers        the C#/WinRT projection (wslcsdkcs.dll) and the native
	                                    wslcsdk.dll that Purview.Containers.Wsl packs under payload/<rid>/.
	    Microsoft.Windows.SDK.NET.Ref   the Microsoft.Windows.SDK.NET/WinRT.Runtime pair the projection
	                                    binds; its version is the WindowsSdkPackageVersion default.

	  They must be declared here and nowhere else. PackageVersion is evaluated in this file, before any
	  project body, so a property declared in a .csproj is too late for PackageVersion to reference.
	  Directory.Build.props is imported earlier still, but the only one in this repository is
	  src/Directory.Build.props, which the samples outside src/ never import; this file is the one
	  every project that needs the value does import. Declaring the version twice is exactly what let
	  the payload path drift from the pin and break the CI pack, so read it from here: there is then
	  nothing left to drift.
	-->
	<PropertyGroup>
		<MicrosoftWSLContainersVersion>3.0.3</MicrosoftWSLContainersVersion>
		<WindowsSdkRefPackageVersion>10.0.26100.80</WindowsSdkRefPackageVersion>
		<TUnitVersion>1.76.0</TUnitVersion>
	</PropertyGroup>

	<ItemGroup Label="Transitive Pinning">
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Microsoft.WSL.Containers" Version="$(MicrosoftWSLContainersVersion)" />
		<PackageVersion Include="Testcontainers" Version="4.16.0" />
		<PackageVersion Include="Microsoft.Extensions.Telemetry.Abstractions" Version="10.11.0" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
		<PackageVersion Include="Purview.Telemetry.SourceGenerator" Version="5.0.5" />
		<PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Core" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)" />
		<!--
		  Project/run-level retry for the container integration suites. This is deliberately a test-only
		  dependency: Microsoft.Testing.Platform's retry extension reruns failed tests by restarting the
		  test host, which is the right granularity for tests that depend on an external runtime. The
		  package is licensed under the Microsoft Testing Platform Tools terms, which permit use in
		  OSI-approved open-source projects; it never ships in a Purview package.
		-->
		<PackageVersion Include="Microsoft.Testing.Extensions.Retry" Version="2.5.1" />
		<PackageVersion Include="Purview.Skills.Testing" Version="1.1.0" />
		<PackageVersion Include="Bogus" Version="35.6.5" />
		<PackageVersion Include="Azure.Core" Version="1.63.0" />
		<PackageVersion Include="Azure.Security.KeyVault.Certificates" Version="4.9.2" />
		<PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
		<PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.2" />
		<!-- Test-only: the Azurite and Service Bus emulator suites prove authenticated client operations. -->
		<PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
		<PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
		<PackageVersion Include="Npgsql" Version="10.0.3" />
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<PackageVersion Include="StackExchange.Redis" Version="3.4.5" />
		<PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
		<PackageVersion Include="NATS.Client.Core" Version="3.3.1" />
		<PackageVersion Include="MySqlConnector" Version="2.6.2" />
	</ItemGroup>
</Project>
