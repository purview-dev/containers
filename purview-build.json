{
	"Build": {
		"Solution": "src/WSLTestContainers.slnx",
		"TestRoot": "src/tests",
		"TestPatterns": "*UnitTests.csproj",
		"TestProjects": "*Tests.csproj",
		"TestFilter": "/*/*/*/*[Category=Unit]"
	},
	"PackValidation": {
		"RequireSymbolPackage": true,
		"RequireSymbolFiles": true,
		// RequireExplicitContent defaults to true, so this is the exhaustive declaration of what each
		// package ships: the library assembly and its XML docs, the bespoke package README
		// (src/src/<Project>/Sdk/README.md) and the shared Purview logo
		// (assets/images/purview-logo-light.png, linked as Sdk/purview-logo-light.png). A package with
		// no rule here, or an entry matching none of its globs, fails validation.
		"RequiredContent": {
			"purview.containers": [
				"lib/$(TFM)/Purview.Containers.dll",
				"lib/$(TFM)/Purview.Containers.xml",
				"README.md",
				"purview-logo-light.png",
				"buildTransitive/Purview.Containers.props",
				"buildTransitive/Purview.Containers.targets"
			],
			"purview.containers.docker": [
				"lib/$(TFM)/Purview.Containers.Docker.dll",
				"lib/$(TFM)/Purview.Containers.Docker.xml",
				"README.md",
				"purview-logo-light.png",
				"buildTransitive/Purview.Containers.Docker.props"
			],
			// Purview.Containers.Wsl is multi-target: lib/net10.0 is the portable facade, and
			// lib/net10.0-windows10.0.19041 is the WSLC implementation. The portable consumer loads
			// that implementation (plus the WSLC projection, its Windows SDK dependencies and the
			// native SDK) from payload/<rid>/ via the buildTransitive targets.
			"purview.containers.wsl": [
				"lib/net10.0/Purview.Containers.Wsl.dll",
				"lib/net10.0/Purview.Containers.Wsl.xml",
				"lib/net10.0-windows10.0.19041/Purview.Containers.Wsl.dll",
				"lib/net10.0-windows10.0.19041/Purview.Containers.Wsl.xml",
				"README.md",
				"purview-logo-light.png",
				"buildTransitive/Purview.Containers.Wsl.props",
				"buildTransitive/Purview.Containers.Wsl.targets",
				"payload/win-x64/*",
				"payload/win-arm64/*"
			],
			"purview.containers.azurite": [
				"lib/$(TFM)/Purview.Containers.Azurite.dll",
				"lib/$(TFM)/Purview.Containers.Azurite.xml",
				"README.md",
				"purview-logo-light.png"
			],
			"purview.containers.mssql": [
				"lib/$(TFM)/Purview.Containers.MsSql.dll",
				"lib/$(TFM)/Purview.Containers.MsSql.xml",
				"README.md",
				"purview-logo-light.png"
			],
			"purview.containers.mysql": [
				"lib/$(TFM)/Purview.Containers.MySql.dll",
				"lib/$(TFM)/Purview.Containers.MySql.xml",
				"README.md",
				"purview-logo-light.png"
			],
			"purview.containers.nats": [
				"lib/$(TFM)/Purview.Containers.Nats.dll",
				"lib/$(TFM)/Purview.Containers.Nats.xml",
				"README.md",
				"purview-logo-light.png"
			],
			"purview.containers.postgresql": [
				"lib/$(TFM)/Purview.Containers.PostgreSql.dll",
				"lib/$(TFM)/Purview.Containers.PostgreSql.xml",
				"README.md",
				"purview-logo-light.png"
			],
			"purview.containers.rabbitmq": [
				"lib/$(TFM)/Purview.Containers.RabbitMq.dll",
				"lib/$(TFM)/Purview.Containers.RabbitMq.xml",
				"README.md",
				"purview-logo-light.png"
			],
			"purview.containers.redis": [
				"lib/$(TFM)/Purview.Containers.Redis.dll",
				"lib/$(TFM)/Purview.Containers.Redis.xml",
				"README.md",
				"purview-logo-light.png"
			]
		}
	},
	"Release": {
		"Mode": "None"
	}
}