<Project>
	<PropertyGroup>
		<NamespacePrefix>Purview</NamespacePrefix>
		<RootPackageJson>$(MSBuildThisFileDirectory)package.json</RootPackageJson>
		<TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<WindowsSdkPackageVersion>10.0.26100.80</WindowsSdkPackageVersion>
		<!-- Core library keeps dependencies minimal; observability uses System.Diagnostics.Activity directly. -->
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
		<ExcludeMSTelemetryExtension>true</ExcludeMSTelemetryExtension>
	</PropertyGroup>

	<Import Sdk="Purview.BuildSdk" Project="Sdk.props" />
</Project>
