<Project>
	<PropertyGroup>
		<NamespacePrefix>Purview.Containers</NamespacePrefix>
		<ExcludePurviewTelemetry Condition="'$(MSBuildProjectName)' == 'Environment'">true</ExcludePurviewTelemetry>
		<TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<WindowsSdkPackageVersion>10.0.26100.80</WindowsSdkPackageVersion>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
	</PropertyGroup>

	<Import Sdk="Purview.BuildSdk" Project="Sdk.props" />

	<!-- Package metadata and assets. IsPackable is resolved by the SDK import above (it scans the
	     project file for <IsPackable>true</IsPackable>), so the conditions must stay after it. The
	     logo is linked beneath Sdk/ so the SDK packs it at the package root and every package ships
	     the same icon as the other Purview projects. Each packable project also carries a bespoke
	     Sdk/README.md, which supersedes the repository README in the package. -->
	<PropertyGroup Label="NuGet package metadata" Condition="'$(IsPackable)' == 'true'">
		<PackageIcon>purview-logo-light.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- The nuget.org "Project Site" link. The rendered documentation wiki lives in this
		     repository, so the repository URL is the most useful target until the aggregated
		     purview.dev project page exists. RepositoryUrl/RepositoryType come from SourceLink. -->
		<PackageProjectUrl>https://github.com/purview-dev/containers</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup Label="NuGet package assets" Condition="'$(IsPackable)' == 'true'">
		<None
			Include="$(MSBuildThisFileDirectory)../assets/images/purview-logo-light.png"
			Link="Sdk/purview-logo-light.png"
		/>
	</ItemGroup>

	<!--
	  Project-level retry for every test project. The retry itself is a run-time option
	  (Microsoft.Testing.Platform's retry-failed-tests flag), not an assembly attribute:
	  Microsoft.Testing.Extensions.Retry reruns failed tests by restarting the test host, so it needs
	  no per-test exception list and no rebuilding to change policy. The package auto-registers through
	  Microsoft.Testing.Platform.MSBuild. Applying it to every test project means a solution-wide
	  `dotnet test` accepts the flag; the integration suites pass it, the unit suites do not.
	-->
	<ItemGroup Condition="'$(TestingType)' != ''">
		<PackageReference Include="Microsoft.Testing.Extensions.Retry" />
	</ItemGroup>
</Project>
