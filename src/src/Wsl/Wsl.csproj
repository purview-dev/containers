<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<!-- The WSL Containers backend is the only Windows-only project: it compiles against the
		     Microsoft.WSL.Containers .NET 11 WinRT projection, so it overrides the subtree's net10.0
		     default (see src/src/Directory.Build.props) and re-applies the Windows build settings that
		     the subtree clears for the cross-platform libraries. -->
		<TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<WindowsSdkPackageVersion>10.0.26100.80</WindowsSdkPackageVersion>
		<Description>WSL Containers backend for Purview.Containers: WSLC-native throwaway Linux containers for .NET integration testing.</Description>
		<PackageTags>wsl;containers;linux;windows;testing;integration</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>Purview</Authors>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../Containers/Containers.csproj" />
		<PackageReference Include="Microsoft.WSL.Containers" />
	</ItemGroup>
</Project>
