<?xml version="1.0" encoding="utf-8"?>
<!--
  Purview.Containers.Wsl consumer defaults (props).

  NuGet imports this file for both direct and transitive references to Purview.Containers.Wsl
  and its service modules, so every consuming project inherits the same baseline without
  copying settings into its own project file. These are defaults only: a consumer that sets
  its own value always wins.

  Why: Microsoft.WSL.Containers 3.0.1 ships a C#/WinRT projection built against
  Microsoft.Windows.SDK.NET 10.0.26100.79. The Windows targeting pack resolved for
  a net10.0-windows10.0.19041.0 target is older (10.0.19041.x), which fails to compile with CS1705
  (the projection "uses 'Microsoft.Windows.SDK.NET' which has a higher version than
  referenced assembly"). Pinning 10.0.26100.80 (the nearest published version) resolves it.
  NOTE: NuGet only auto-imports buildTransitive/<PackageId>.props and buildTransitive/<PackageId>.targets.
-->
<Project>
	<PropertyGroup>
		<WindowsSdkPackageVersion Condition="'$(WindowsSdkPackageVersion)' == ''"
			>10.0.26100.80</WindowsSdkPackageVersion>

		<!-- Registers the WSL Containers backend inside the consuming assembly. The generated module
		     initializer is produced by Purview.Containers.targets (shipped by the
		     Purview.Containers package, which always flows here transitively). -->
		<PurviewContainersBackends>$(PurviewContainersBackends);Purview.Containers.Wsl.WslContainerBackend</PurviewContainersBackends>
	</PropertyGroup>
</Project>
