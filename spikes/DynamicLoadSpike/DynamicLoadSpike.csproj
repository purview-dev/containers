<Project Sdk="Microsoft.NET.Sdk">
	<!--
	  Phase 0 feasibility probe for "dynamic WSLC from a platform-neutral TFM".

	  This project deliberately targets plain net10.0 - the TFM a normal consumer test project has -
	  and does NOT reference Microsoft.WSL.Containers (that reference is impossible from a
	  platform-neutral TFM). Instead it copies the WSLC projection, its Windows SDK dependencies and
	  the native SDK into a local "payload" folder and loads them at runtime. The probe answers two
	  questions before the design is committed to:

	    1. What does the WSLC projection actually target, and which assemblies does it reference?
	       (static metadata read - runs on any OS)
	    2. Can a net10.0 process load that projection from the payload and call into WSLC?
	       (dynamic - Windows only)

	  Run: dotnet run (project: spikes/DynamicLoadSpike)
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PlatformTarget>x64</PlatformTarget>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<NoWarn>$(NoWarn);CA1031;CA1304;CA1305;CA1307;CA1310;CA1849;CA2000;CA2027;CA1707;CA1822;CA1062;CA1515;CA1861;CA1819;IDE0040;IDE0060;IDE0074;IDE0007;IDE0305;CS4014</NoWarn>
	</PropertyGroup>

	<!--
	  The payload. $(NuGetPackageRoot) is written by restore (NuGet.g.props); it points at the global
	  packages folder. The versions below mirror the repository pins: Microsoft.WSL.Containers 3.0.1
	  and the WindowsSdkPackageVersion 10.0.26100.80 used by the WSL backend.
	-->
	<PropertyGroup>
		<WslcPayloadSource>$(NuGetPackageRoot)microsoft.wsl.containers/3.0.1</WslcPayloadSource>
		<WindowsSdkPayloadSource>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref/10.0.26100.80</WindowsSdkPayloadSource>
	</PropertyGroup>

	<ItemGroup>
		<None
			Include="$(WslcPayloadSource)/lib/net8.0-windows10.0.19041.0/wslcsdkcs.dll"
			Link="payload/wslcsdkcs.dll"
			CopyToOutputDirectory="PreserveNewest"
		/>
		<None
			Include="$(WindowsSdkPayloadSource)/lib/net8.0/Microsoft.Windows.SDK.NET.dll"
			Link="payload/Microsoft.Windows.SDK.NET.dll"
			CopyToOutputDirectory="PreserveNewest"
		/>
		<None
			Include="$(WindowsSdkPayloadSource)/lib/net8.0/WinRT.Runtime.dll"
			Link="payload/WinRT.Runtime.dll"
			CopyToOutputDirectory="PreserveNewest"
		/>
		<None
			Include="$(WslcPayloadSource)/runtimes/win-x64/native/wslcsdk.dll"
			Link="payload/wslcsdk.dll"
			CopyToOutputDirectory="PreserveNewest"
		/>
	</ItemGroup>
</Project>
